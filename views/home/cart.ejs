<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart | Game Store</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/storeStyle/cart.css">
</head>
<body>
    <header class="site-header">
        <div class="site-logo">Game<span>Store</span></div>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/favorites">Favorites</a>
            <a href="/library">Biblioteca</a>
        </nav>
    </header>

    <main class="cart-container">
        <h1 class="section-title">Your Shopping Cart</h1>
        <div class="section-divider" style="margin-bottom: 3rem;"></div>

        <% if(cart.length === 0) { %>
            <div class="empty-state">
                <p>Your cart is empty.</p>
                <a href="/" class="btn btn-outline" style="margin-top: 2rem; width: auto;">Discover Games</a>
            </div>
        <% } else { %>
            <ul class="cart-list">
                <% let total = 0; %>
                <% cart.forEach((game) => { %>
                    <% total += Number(game.price); %>
                    <li class="cart-item">
                        <img src="<%= game.image_url %>" alt="<%= game.title %>" class="cart-item__image">
                        
                        <div class="cart-item__info">
                            <h2 class="cart-item__title"><%= game.title %></h2>
                            <p class="cart-item__price">$<%= Number(game.price).toFixed(2) %></p>
                        </div>

                        <form action="/cart/remove" method="POST">
                            <input type="hidden" name="game_id" value="<%= game.id %>">
                            <button type="submit" class="btn btn-ghost" style="color: var(--text-muted); font-size: 0.8rem;">
                                Remove
                            </button>
                        </form>
                    </li>
                <% }) %>
            </ul>

            <div class="cart-summary">
                <span class="cart-summary__total-label">Total Amount</span>
                <span class="cart-summary__total-value">$<%= total.toFixed(2) %></span>

                <div class="cart-actions">
                    <a href="/" class="btn btn-ghost">Continue Shopping</a>
                    <form action="/cart/checkout" method="POST">
                        <button type="submit" class="btn btn-primary" style="padding: 1rem 3rem;">
                            Confirm Purchase
                        </button>
                    </form>
                </div>
            </div>
        <% } %>
    </main>

    <footer class="site-footer" style="margin-top: 4rem; text-align: center; padding: 2rem; border-top: 1px solid var(--border-subtle);">
        <p>&copy; <%= new Date().getFullYear() %> Game Store — Secure Checkout</p>
    </footer>
</body>
</html>