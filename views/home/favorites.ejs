<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Favorites | Game Store</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
</head>
<body>
    <header class="site-header">
        <div class="site-logo"><a href="/">Game<span>Store</span></a></div>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/cart">
                Cart <span class="cart-badge"><%= locals.cart ? cart.length : 0 %></span>
            </a>
            <a href="/library">Biblioteca</a>
        </nav>
    </header>

    <main class="store-main">
        <h1 class="section-title">Favorites</h1>
        <p class="section-subtitle">Your personal collection of must-play titles</p>
        <div class="section-divider"></div>

        <% if(favorites.length === 0) { %>
            <div class="empty-state">
                <p>Your wishlist is currently empty.</p>
                <a href="/" class="btn btn-outline" style="margin-top: 2rem; width: auto;">Discover Games</a>
            </div>
        <% } else { %>
            <ul class="games-grid">
                <% favorites.forEach((game) => { %>
                    <li class="game-card">
                        <div class="game-card__image-wrap">
                            <img src="<%= game.image_url %>" alt="<%= game.title %>">
                            <div class="game-card__overlay">
                                <div class="game-card__quick-actions">
                                    <a href="/games/<%= game.id %>" class="btn btn-primary">View Details</a>
                                </div>
                            </div>
                        </div>

                        <div class="game-card__body">
                            <div class="game-card__meta">
                                <span class="game-card__release"><%= new Date(game.release_date).toLocaleDateString('pt-BR') %></span>
                                <span class="game-card__price">$<%= game.price %></span>
                            </div>
                            
                            <h2 class="game-card__title"><%= game.title %></h2>

                            <div class="game-card__actions">
                                <form action="/favorites/remove" method="POST" style="flex:1">
                                    <input type="hidden" name="game_id" value="<%= game.id %>">
                                    <button type="submit" class="btn btn-ghost" style="color: var(--text-muted);">Remove</button>
                                </form>

                                <form action="/cart/add" method="POST" style="flex:1">
                                    <input type="hidden" name="game_id" value="<%= game.id %>">
                                    <button type="submit" class="btn btn-outline">Add to Cart</button>
                                </form>
                            </div>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </main>

    <footer style="padding: 2rem 2.5rem; text-align: center;">
        <a href="/" class="btn-ghost" style="font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">
            ← Continue Shopping
        </a>
    </footer>
</body>
</html>