<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.title %></title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/adminStyle/admin-game-details.css">
</head>
<body>

    <header class="site-header">
        <a href="/" class="site-logo">Game<span>Store</span></a>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/favorites">Favorites</a>
            <a href="/cart">Cart <span class="cart-badge"><%= cart.length %></span></a>
        </nav>
    </header>

    <main class="details-container">

        <div class="details-hero">
            <img src="<%= game.image_url %>" alt="<%= game.title %>" class="details-hero__image">
            
            <div class="details-hero__content">
                <h1 class="section-title"><%= game.title %></h1>
                <div class="section-divider"></div>

                <div class="details-meta">
                    <div class="details-meta__item">
                        Released 
                        <b><%= game.release_date %></b>
                    </div>
                    <div class="details-meta__item">
                        Rating 
                        <b><%= game.rating || 'N/A' %></b>
                    </div>
                    <div class="details-meta__item">
                        Metacritic 
                        <b><%= game.metacritic || 'N/A' %></b>
                    </div>
                    <div class="details-meta__item">
                        Price 
                        <b>$<%= game.price %></b>
                    </div>
                </div>

                <div class="game-card__actions">
                    <form action="/favorites/add" method="POST" style="flex:1">
                        <input type="hidden" name="game_id" value="<%= game.id %>">
                        <button type="submit" class="btn btn-ghost">♡ Favorite</button>
                    </form>

                    <form action="/cart/add" method="POST" style="flex:1">
                        <input type="hidden" name="game_id" value="<%= game.id %>">
                        <button type="submit" class="btn btn-primary">Add to Cart</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="details-grid">
            <section class="details-section">
                <h2>Genres</h2>
                <ul class="details-list">
                    <% game.genres.forEach((genre) => { %>
                        <li><a href="/genres/<%= genre.id %>" class="genre-tag"><%= genre.name %></a></li>
                    <% }) %>
                </ul>
            </section>

            <section class="details-section">
                <h2>Platforms</h2>
                <ul class="details-list">
                    <% game.platforms.forEach((platform) => { %>
                        <li><%= platform.name %></li>
                    <% }) %>
                </ul>
            </section>

            <section class="details-section">
                <h2>Developers</h2>
                <ul class="details-list">
                    <% game.developers.forEach((dev) => { %>
                        <li><%= dev.name %></li>
                    <% }) %>
                </ul>
            </section>
        </div>

        <section class="details-section">
            <h2>Description</h2>
            <div class="details-description">
                <%- game.description %>
            </div>
        </section>

        <div style="margin-top: 2rem;">
            <a href="/" class="btn btn-ghost">← Back to Store</a>
        </div>

    </main>

</body>
</html>