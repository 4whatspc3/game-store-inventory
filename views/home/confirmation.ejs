<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed | Game Store</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/confirmation.css">
</head>
<body>
    <header class="site-header">
        <div class="site-logo">Game<span>Store</span></div>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/favorites">Favorites</a>
            <a href="/cart">
                Cart <span class="cart-badge"><%= locals.cart ? cart.length : 0 %></span>
            </a>
        </nav>
    </header>

    <main class="confirmation-container">
        <section class="confirmation-card">
            <span class="confirmation-icon">✓</span>
            
            <h1 class="section-title">Order Confirmed</h1>
            <div class="section-divider"></div>
            
            <p class="confirmation-text">
                Thank you for your purchase. Your order has been processed successfully.
            </p>
            
            <p class="confirmation-subtext">
                The digital keys are now available in your library. 
                A formal receipt has been dispatched to your email address.
            </p>
            
            <div class="confirmation-actions">
                <a href="/" class="btn btn-primary">Return to Store</a>
                <a href="/library" class="btn btn-ghost">View Library</a>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <p>&copy; <%= new Date().getFullYear() %> Game Store — Premium Digital Distribution</p>
    </footer>
</body>
</html>