<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Store</title>
</head>
<body>
    <header>
        <h1>Game Store</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/favorites">Favorites</a>
            <a href="/cart">Cart (<%= locals.cart ? cart.length : 0 %>)</a>
        </nav>
    </header>

    <main>
        <% if(games.length === 0) { %>
            <p>No games available.</p>
        <% } else { %>
            <ul>
                <% games.forEach((game) => { %>
                    <li>
                        <img src="<%= game.image_url %>" alt="<%= game.title %>" style="max-width:200px;">
                        <h2><%= game.title %></h2>
                        <p>Released: <%= game.release_date %></p>
                        <p>Price: $<%= game.price %></p>

                        <ul>
                            <% game.genres.forEach((genre) => { %>
                                <li>
                                    <a href="/genres/<%= genre.id %>"><%= genre.name %></a>
                                </li>
                            <% }) %>
                        </ul>

                        <a href="/games/<%= game.id %>">View details</a>

                        <form action="/favorites/add" method="POST">
                            <input type="hidden" name="game_id" value="<%= game.id %>">
                            <button type="submit">Add to Favorites</button>
                        </form>

                        <form action="/cart/add" method="POST">
                            <input type="hidden" name="game_id" value="<%= game.id %>">
                            <button type="submit">Add to Cart</button>
                        </form>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </main>
</body>
</html>