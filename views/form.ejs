<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if(locals.errors) { %>
        <ul>
            <% errors.forEach((err) => { %>
                <li><%= err.msg %></li>
            <% }) %>
        </ul>
    <% } %>
    <section aria-label="form-section" class="form-section">
    <form method="POST" action="/form">
        <div>
            <label for="user">User:</label>
            <input type="text" id="user" name="user" placeholder="Random Citizen">
        </div>

        <div>
            <label for="message">Message:</label>
            <input type="text" id="message" name="message" placeholder="What year is it?">
        </div>

        <button type="submit">Submit</button>
    </form>
</section>
</body>
</html>
