<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <header> <%= title %></header>
    <main>
        <ul>
            <% messages.forEach((el) => { %>
                <li>
                    <small><%= el.id %></small>
                    <h1><%= el.user %></h1>
                    <p><%= el.message %></p>
                    <time><%= el.added %></time>
                </li>
            <% }) %>
        </ul>
        <a href="/form">Insert new data:</a>
    </main>
</body>
</html>