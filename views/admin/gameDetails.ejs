<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.name %> | Admin Details</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/admin.css">
    <link rel="stylesheet" href="/admin-game-details.css">
    <link rel="stylesheet" href="/admin-add-game.css">
</head>
<body class="admin-body">
    <div class="details-container">
        <header class="details-hero">
            <img src="<%= game.background_image %>" alt="<%= game.name %>" class="details-hero__image">
            
            <div class="details-hero__content">
                <h1 class="section-title" style="text-align: left; margin: 0;"><%= game.name %></h1>
                
                <div class="details-meta">
                    <div class="details-meta__item">Released <b><%= game.released %></b></div>
                    <div class="details-meta__item">Rating <b><%= game.rating %> / <%= game.rating_top %></b></div>
                    <div class="details-meta__item">Metacritic <b><%= game.metacritic || 'N/A' %></b></div>
                    <div class="details-meta__item">ESRB <b><%= game.esrb_rating ? game.esrb_rating.name : 'Not Rated' %></b></div>
                </div>

                <%- include("./addGame", {rawg_id: game.id}) %>
            </div>
        </header>

        <div class="details-grid">
            <section class="details-section">
                <h2>Genres</h2>
                <ul class="details-list">
                    <% game.genres.forEach((genre) => { %>
                        <li><%= genre.name %></li>
                    <% }) %>
                </ul>
            </section>

            <section class="details-section">
                <h2>Platforms</h2>
                <ul class="details-list">
                    <% game.platforms.forEach((el) => { %>
                        <li><%= el.platform.name %></li>
                    <% }) %>
                </ul>
            </section>

            <section class="details-section">
                <h2>Developers</h2>
                <ul class="details-list">
                    <% game.developers.forEach((dev) => { %>
                        <li><%= dev.name %></li>
                    <% }) %>
                </ul>
            </section>
        </div>

        <section class="details-section">
            <h2>Description</h2>
            <div class="details-description">
                <%- game.description %>
            </div>
        </section>

        <footer style="margin-top: 4rem;">
            <a href="/admin" class="back-link">← Back to search</a>
        </footer>
    </div>
</body>
</html>