<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Search Result</h1>
    
    <% if(games.length === 0) { %>
        <p>No games found.</p>
    <% } else { %>
        <ul>
            <% games.forEach((game) => { %>
            <li>
                <img src="<%= game.background_image %>" alt="<%= game.name %>" style="max-width:200px; height:auto;">
                <h2><%= game.name %></h2>
                <p>Released: <%= game.released %></p>
                <p>Rating: <%= game.rating %></p>
            </li>    
            <% }) %>
        </ul>
    <% } %>

    <a href="/admin">Back to search</a>
</body>
</html>