<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Search | Game Store</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/admin.css">
</head>
<body class="admin-body">
    <div class="search-wrapper">
        <h1 class="section-title">Inventory Search</h1>
        <div class="section-divider" style="margin: 0 auto;"></div>

        <form action="/admin/search" method="GET" class="search-form">
            <input type="text"
                   name="query"
                   placeholder="Enter game title..." 
                   required>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        <a href="/admin/library" class="back-link" style="display: inline-block;">
            Access Library →
        </a>
    </div>
</body>
</html>