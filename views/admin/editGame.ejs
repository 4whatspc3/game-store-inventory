<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= game.title %> | Admin</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/admin.css">
    <link rel="stylesheet" href="/admin-edit-game.css">
    <link rel="stylesheet" href="/admin-add-game.css">
</head>
<body class="edit-body">
    <div class="add-game-box edit-form-page">
        <header class="edit-form-header">
            <h1 class="section-title"><%= game.title %></h1>
            <p class="edit-form-subtitle">Atualizar Informações de Venda</p>
        </header>

        <form action="/admin/games/<%= game.id %>/edit" method="POST" class="add-game-form">
            <div class="price-group">
                <label for="price">Preço de Venda (BRL)</label>
                <div class="price-input-wrapper">
                    <input type="number" 
                           id="price"
                           name="price" 
                           step="0.01" 
                           value="<%= game.price %>" 
                           required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                Salvar Alterações
            </button>
        </form>

        <footer class="edit-form-footer">
            <a href="/admin/library" class="back-link">
                ← Voltar para a Biblioteca
            </a>
        </footer>
    </div>
</body>
</html>