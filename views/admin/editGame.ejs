<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit <%= game.title %></title>
</head>
<body>
    <h1><%= game.title %></h1>

    <form action="/admin/games/<%= game.id %>/edit" method="POST">
        <label>Price: <input type="number" name="price" step="0.01" value="<%= game.price %>" required></label>
        <label>Stock: <input type="number" name="stock" value="<%= game.stock %>" required></label>
        <button type="submit">Save</button>
    </form>

    <a href="/admin/library">Back to library</a>
</body>
</html>