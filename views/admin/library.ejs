<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Library | Admin</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/adminStyle/admin.css">
    <link rel="stylesheet" href="/adminStyle/library.css">
    <link rel="stylesheet" href="/filter.css">
</head>
<body class="admin-body">
    <div class="library-container">
        <header class="library-header">
            <h1 class="section-title">Game Library</h1>
            <form action="/admin/logout" method="POST">
                <button type="submit" class="btn btn-ghost">Logout</button>
            </form>
        </header>

        <div class="section-divider"></div>

        <div class="filter-bar">
            <select onchange="window.location.href = this.value ? '/admin/library/genres/' + this.value : '/admin/library'">
                <option value="">All Genres</option>
                <% genres.forEach((genre) => { %>
                    <option value="<%= genre.id %>" <%= typeof currentGenreId !== 'undefined' && currentGenreId === genre.id ? 'selected' : '' %> >
                        <%= genre.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <main>
            <% if(games.length === 0) { %>
                <div class="empty-state">
                    <p>No games in the library yet.</p>
                </div>
            <% } else { %>
                <ul class="library-list"> <% games.forEach((game) => { %>
                        <li class="library-item">
                            <img src="<%= game.image_url %>" alt="<%= game.title %>" class="library-item__image">
                            
                            <div class="library-item__info">
                                <h2 class="library-item__title"><%= game.title %></h2>
                                <p class="library-item__price">$<%= game.price %></p>
                            </div>

                            <div class="library-item-actions">
                                <a href="/admin/games/<%= game.id %>/edit" class="btn btn-outline btn-edit">Edit</a>
                                
                                <form action="/admin/games/<%= game.id %>/delete" method="POST" onsubmit="return confirm('Are you sure?')">
                                    <button type="submit" class="btn btn-ghost btn-delete">Delete</button>
                                </form>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </main>

        <footer class="library-footer">
            <a href="/admin" class="back-link">← Back to search</a>
        </footer>
    </div>
</body>
</html>