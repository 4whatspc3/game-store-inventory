<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Game Library</title>
</head>
<body>
    <h1>Game Library</h1>

    <% if(games.length === 0) { %>
        <p>No games in the library yet.</p>
    <% } else { %>
        <ul>
            <% games.forEach((game) => { %>
                <li>
                    <img src="<%= game.image_url %>" alt="<%= game.title %>" style="max-width:100px;">
                    <h2><%= game.title %></h2>
                    <p>Price: <%= game.price %></p>
                    <a href="/admin/games/<%= game.id %>/edit">Edit</a>
                    <form action="/admin/games/<%= game.id %>/delete" method="POST">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } %>

    <a href="/admin">Back to search</a>
</body>
</html>